# .env — DO NOT COMMIT. Copy to .env and fill in real values.

# API origin for the WorkSync server. Leave unset to use the deployed
# https://work-sync-server-eight.vercel.app default. If you point this at a
# different origin, the CSP in firebase.json must allow it too (connect-src).
VITE_API_BASE_URL=

# Shared secret the server requires in the `x-admin-token` header on its
# protected routes (registration, contact form, worksheet writes, and the
# admin/HR bulk reads and payroll actions). Must match the server's
# ADMIN_TOKEN. This value is compiled into the public bundle and is not a
# user credential; the server is the authorization boundary.
# Generate with: openssl rand -hex 32
VITE_ADMIN_TOKEN=

# Firebase web config (Project settings → General → Your apps → SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
